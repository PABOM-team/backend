SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL="jdbc:mysql://pabom-dev-db.clqyo66222ox.ap-northeast-2.rds.amazonaws.com:3306/pabom_dev?useSSL=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8"
DB_USERNAME=pabom_app
DB_PASSWORD=replace_with_database_password

JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes

KAKAO_CLIENT_ID=replace_with_kakao_client_id
KAKAO_CLIENT_SECRET=replace_with_kakao_client_secret
KAKAO_REDIRECT_URI=https://dev.pabom.app/api/v1/auth/kakao/callback

GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=https://dev.pabom.app/api/v1/auth/google/callback

AUTH_ALLOWED_ORIGINS=https://dev.pabom.app

# Prefer an EC2 instance profile. Do not store long-lived AWS access keys here.
AWS_REGION=ap-northeast-2
AWS_EC2_METADATA_V1_DISABLED=true
S3_BUCKET=replace_with_dev_bucket_name
S3_PRESIGNED_URL_EXPIRATION_SECONDS=3600

# Optional runtime tuning
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
SHUTDOWN_TIMEOUT=30s
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_HIBERNATE_SQL=WARN
