SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_HOST=your-rds-endpoint
DB_PORT=3306
DB_NAME=pabom
DB_USERNAME=pabom_app
DB_PASSWORD=replace_with_database_password
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
KAKAO_CLIENT_ID=replace_with_kakao_client_id
KAKAO_CLIENT_SECRET=replace_with_kakao_client_secret
KAKAO_REDIRECT_URI=https://dev.api.pabom.app/api/v1/auth/kakao/callback
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=https://dev.api.pabom.app/api/v1/auth/google/callback
AUTH_ALLOWED_ORIGINS=https://dev.pabom.app
AWS_REGION=ap-northeast-2
AWS_EC2_METADATA_V1_DISABLED=true
S3_BUCKET=replace_with_dev_bucket_name
S3_PRESIGNED_URL_EXPIRATION_SECONDS=3600
