# 로컬 MySQL 접속 정보
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pabom
DB_USERNAME=pabomUser
DB_PASSWORD=change_me_local_password

# MySQL 컨테이너 초기화에만 사용하는 관리자 비밀번호
MYSQL_ROOT_PASSWORD=change_me_root_password

# Kakao OAuth
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback
KAKAO_STATE_COOKIE_SECURE=false

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_STATE_COOKIE_SECURE=false

# Service JWT (at least 32 bytes)
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes

# Auth session
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
